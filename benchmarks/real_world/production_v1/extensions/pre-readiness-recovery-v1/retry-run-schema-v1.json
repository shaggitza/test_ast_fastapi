      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "protocol": {
          "const": "ground-truth-review-canary-pre-readiness-retry-run-v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_hash": {
          "$ref": "#/$defs/hash"
        },
        "entry_hash": {
          "$ref": "#/$defs/hash"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^prod-v1-i[0-9]{3}-rank[0-9]{3}-pr[0-9]+-[AB]$"
        },
        "grant_entry_hash": {
          "$ref": "#/$defs/hash"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "retry_prepared"
        },
        "binding_sha256": {
          "$ref": "#/$defs/hash"
        },
        "runtime_attestation_entry_hash": {
          "$ref": "#/$defs/hash"
        },
        "prepared_at": {
          "type": "string",
          "format": "date-time"
        },
        "broker_bundle_lease_receipt_sha256": {
          "$ref": "#/$defs/hash"
        }
