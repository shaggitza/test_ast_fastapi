    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol",
        "sequence",
        "previous_hash",
        "entry_hash",
        "attempt_id",
        "grant_entry_hash",
        "run_id",
        "kind",
        "failure",
