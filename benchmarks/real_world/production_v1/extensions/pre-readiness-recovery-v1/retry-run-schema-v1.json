      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "protocol": {
          "const": "ground-truth-review-canary-pre-readiness-retry-run-v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
