{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ground-truth-pre-readiness-retry-state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "phase",
    "run_id",
    "retry_ordinal",
    "campaign_attempt_id",
    "rank",
    "lane",
    "binding",
    "binding_sha256",
    "broker_bundle_lease_receipt_sha256",
    "broker_pid",
    "broker_start_identity",
    "socket",
    "registry",
    "runtime_attestation_entry_hash",
    "recovery_grant_entry_hash",
    "prepared_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "ground-truth-review-canary-pre-readiness-retry-run-v1"
    },
    "phase": {
      "const": "broker_ready"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "retry_ordinal": {
      "const": 1
    },
    "campaign_attempt_id": {
      "type": "string",
      "pattern": "^prod-v1-i[0-9]{3}-rank[0-9]{3}-pr[0-9]+-[AB]$"
    },
    "rank": {
      "const": 1
    },
    "lane": {
      "enum": [
        "A",
        "B"
      ]
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "binding_sha256": {
      "$ref": "#/$defs/hash"
    },
    "broker_pid": {
      "type": "integer",
      "minimum": 1
    },
    "broker_start_identity": {
      "type": "string",
      "minLength": 1
    },
    "socket": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "runtime_attestation_entry_hash": {
      "$ref": "#/$defs/hash"
    },
    "recovery_grant_entry_hash": {
      "$ref": "#/$defs/hash"
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "broker_bundle_lease_receipt_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "const": "A"
          }
        }
      },
      "then": {
        "properties": {
          "campaign_attempt_id": {
            "pattern": "-A$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "const": "B"
          }
        }
      },
      "then": {
        "properties": {
          "campaign_attempt_id": {
            "pattern": "-B$"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
