{
  "authorization": {
    "all_preconditions_before_authorization_append": true,
    "authorization_single_use": true,
    "campaign_packet_gate_remains_false": true,
    "canonical_import": false,
    "layered_transition_required": true,
    "live_launch": false,
    "packet_materialization_granted_by_transition_only": true,
    "post_expiry_validation_requires_in_window_publication": true,
    "publication_recovery_command": "finalize-packets",
    "publication_successor_required": true,
    "source_binding_packet_gate_remains_false": true,
    "validity_seconds": 86400
  },
  "bounds": {
    "aggregate_entries": 500000,
    "aggregate_payload_bytes": 26843545600,
    "blob_bytes": 33554432,
    "diff_bytes": 33554432,
    "diff_spool_bytes": 33554432,
    "files_per_packet": 10000,
    "metadata_reserve_bytes_per_entry": 4096,
    "minimum_disk_headroom_bytes": 268435456,
    "packets": 50,
    "payload_bytes_per_packet": 536870912,
    "snapshot_bytes": 268435456,
    "spool_bytes": 272629760,
    "tree_bytes": 67108864,
    "unique_commits": 100
  },
  "forbidden_reviewer_packet_data": [
    "lane identities",
    "reviewer identities",
    "ledger",
    "rank",
    "analyzer output",
    "truth labels",
    "prior review",
    "adjudication",
    "host paths",
    "cache paths",
    "capabilities"
  ],
  "git": {
    "aggregate_command_counter": true,
    "aggregate_deadline_seconds": 21600,
    "command_timeout_seconds": 180,
    "commands_per_packet": 5,
    "commands_per_pass": 250,
    "diff_argv_template": [
      "git",
      "-c",
      "core.hooksPath=/dev/null",
      "-c",
      "filter.lfs.smudge=",
      "-c",
      "core.useReplaceRefs=false",
      "-c",
      "maintenance.auto=false",
      "-c",
      "gc.auto=0",
      "-C",
      "{authenticated_exact_cache}",
      "diff",
      "--no-ext-diff",
      "--no-textconv",
      "--no-color",
      "--no-renames",
      "--binary",
      "--full-index",
      "{baseline_commit}",
      "{target_commit}"
    ],
    "per_command_deadline_refresh": true,
    "version": "git version 2.43.0"
  },
  "id": "ground-truth-production-packet-policy-v1",
  "packet": {
    "atomic_publication": "renameat2(RENAME_NOREPLACE)",
    "count": 50,
    "filesystem_symlinks": false,
    "gitlink_contents_omitted": true,
    "local_to_remote_relation": "not_compared",
    "output_directory_mode": "0500",
    "output_file_mode": "0400",
    "policy_files": [
      "packet-policy-v1.json",
      "packet-manifest-schema-v1.json"
    ],
    "publication_transition": "packet-materialization-publication-v1",
    "remote_payload_present": false,
    "reviewer_visible_top_level": [
      "baseline",
      "target",
      "snapshot.diff",
      "packet-manifest.json",
      "source-structure.json",
      "policies"
    ]
  },
  "pilot_bytes_mutated": false,
  "schema_version": 1,
  "scope": "one authenticated 50-PR repository campaign"
}
