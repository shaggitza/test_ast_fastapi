{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gh103:source-evidence-v2.schema.json",
  "title": "GH103 v2 source evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "source_evidence_collector_sha256",
    "source_policy_sha256",
    "lock_sha256",
    "manifest_sha256",
    "longlist_sha256",
    "source_policy_id",
    "network_budget",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "gh103-v2-source-evidence"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_evidence_collector_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_policy_sha256": {
      "$ref": "#/$defs/digest"
    },
    "lock_sha256": {
      "$ref": "#/$defs/digest"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "longlist_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_policy_id": {
      "const": "gh103-source-evidence-policy-v1"
    },
    "network_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "tree_requests",
        "blob_requests",
        "overhead_requests",
        "pages",
        "response_bytes",
        "wall_seconds",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500
        },
        "tree_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "blob_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "overhead_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1200
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "tree_requests",
            "blob_requests",
            "overhead_requests",
            "response_bytes",
            "wall_seconds"
          ],
          "properties": {
            "requests": {
              "const": 1500
            },
            "tree_requests": {
              "const": 200
            },
            "blob_requests": {
              "const": 1200
            },
            "overhead_requests": {
              "const": 100
            },
            "response_bytes": {
              "const": 268435456
            },
            "wall_seconds": {
              "const": 1200
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr",
        "base_sha",
        "head_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "path",
        "blob_sha",
        "size",
        "content_sha256"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "python_versions",
        "license",
        "dependencies"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "python_versions": {
          "$ref": "#/$defs/pythonGroup"
        },
        "license": {
          "$ref": "#/$defs/licenseGroup"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyGroup"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "base",
        "head"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "base": {
          "$ref": "#/$defs/side"
        },
        "head": {
          "$ref": "#/$defs/side"
        }
      }
    },
    "pythonLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "literal"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "python-version-literal-v1"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "pythonRequires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "expression"
      ],
      "properties": {
        "kind": {
          "const": "requires-python"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "pyproject-requires-python-v1"
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "pythonRequiresCfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "expression"
      ],
      "properties": {
        "kind": {
          "const": "python_requires"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "setup-cfg-python-requires-v1"
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "toxEnvlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "tox-envlist"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "tox-envlist-python-factors-v1"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spdxFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "expression"
      ],
      "properties": {
        "kind": {
          "const": "spdx_identifier_expression"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "spdx-line-v1"
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "licensePresent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id"
      ],
      "properties": {
        "kind": {
          "const": "license_file_present"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "const": "license-presence-v1"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "name",
        "specifier"
      ],
      "properties": {
        "kind": {
          "const": "declared_dependency"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "enum": [
            "pyproject-static-dependencies-v1",
            "requirements-static-line-v1"
          ]
        },
        "name": {
          "type": "string"
        },
        "specifier": {
          "type": "string"
        }
      }
    },
    "dependencyFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "rule_id",
        "form"
      ],
      "properties": {
        "kind": {
          "const": "declaration_file_present"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "rule_id": {
          "enum": [
            "setup-py-inert-presence-v1",
            "requirements-presence-v1",
            "declaration-file-presence-v1"
          ]
        },
        "form": {
          "enum": [
            "dynamic_or_unsupported",
            "empty_requirements_file",
            "format_present_unparsed"
          ]
        }
      }
    },
    "pythonFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/pythonLiteral"
        },
        {
          "$ref": "#/$defs/pythonRequires"
        },
        {
          "$ref": "#/$defs/pythonRequiresCfg"
        },
        {
          "$ref": "#/$defs/toxEnvlist"
        }
      ]
    },
    "licenseFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/spdxFact"
        },
        {
          "$ref": "#/$defs/licensePresent"
        }
      ]
    },
    "dependencyFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/dependency"
        },
        {
          "$ref": "#/$defs/dependencyFile"
        }
      ]
    },
    "groupCore": {
      "type": "object",
      "required": [
        "status",
        "reason_codes",
        "declarations_present",
        "candidate_count",
        "omitted_candidate_count",
        "omitted_candidate_paths",
        "unknown_count",
        "sources"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "missing",
            "uncertain",
            "multiple_or_conflicting",
            "unsupported"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "candidate_limit",
              "file_oversize",
              "invalid_utf8",
              "multiple_evidence_items",
              "no_candidate_paths",
              "parse_error",
              "source_byte_limit",
              "source_unavailable_http_301",
              "source_unavailable_http_404",
              "source_unavailable_http_410",
              "tree_entry_limit",
              "tree_incomplete",
              "tree_page_limit",
              "tree_page_truncated",
              "tree_page_unavailable",
              "tree_repeated_sha",
              "tree_truncation_flag_invalid",
              "unsupported_syntax"
            ]
          },
          "uniqueItems": true
        },
        "declarations_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "omitted_candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "omitted_candidate_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcePath"
          },
          "uniqueItems": true
        },
        "unknown_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "observed"
                }
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "pythonGroup": {
      "allOf": [
        {
          "$ref": "#/$defs/groupCore"
        },
        {
          "type": "object",
          "required": [
            "facts"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pythonFact"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "licenseGroup": {
      "allOf": [
        {
          "$ref": "#/$defs/groupCore"
        },
        {
          "type": "object",
          "required": [
            "facts"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/licenseFact"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dependencyGroup": {
      "allOf": [
        {
          "$ref": "#/$defs/groupCore"
        },
        {
          "type": "object",
          "required": [
            "facts"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dependencyFact"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\u0000)(?!.*\\/$).+$"
    }
  }
}
